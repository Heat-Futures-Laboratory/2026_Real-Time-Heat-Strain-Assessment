'CR1000x Datalogger code by Muhammad Abdullah (ASU)
'Integrated Thermoregulation Model & Control System with Environmental & Physiological Outputs
'
'Abdullah, M., Joshi, A., Viswanathan, S. H., Vanos, J., Middel, A., Rotella, J., & Rykaczewski, K. (2026).
'Linking Urban Microclimate Sensing and Thermoregulation Modeling for Real-Time Heat-Strain Assessment. Nexus.
'https://doi.org/10.1016/j.ynexs.2026.100184

'==================================================
' Variable Declarations & Units
'==================================================
Dim WSStr As String * 21
Dim ByteRet
Dim ChkSumF As Boolean
Dim WSData(4)
Dim NMEASent(2) As String * 100
Dim i, k, j, time
'------ Standard Sensor Variables (Environmental) ------
Public BattV, PTemp_C
Public SN500Data1(4), SN500Data2(2)
Public SWalbedo, NR
Public SN500Data1_2(4), SN500Data2_2(2)
Public SWalbedo_2, NR_2
Public SN500Data1_3(4), SN500Data2_3(2)
Public SWalbedo_3, NR_3
Public GPSData(15)
Public WindDir
Public WS_ms
Public WSDiag
Public N(9)
Public AirTC, RH, MRT
Public Qsk_latent_total, Qsk_sensible_total, m_sweat_total
Public P_air As Double
Public Psat_air As Double
Public P_atm As Double
Public L_c As Double
Public C(25) As Double
Public CLDS As Double   ' Aggregated cold signal from skin receptors
Public WRMS As Double   ' Aggregated warm signal from skin receptors
Public Shivering As Double
Public SW As Double     ' Sweating signal (before further processing)

'------ Thermoregulation Model Variables & Parameters ------
Public weight, height, age, met  ' met = metabolic rate [met]
Public Rc_cl(6), Re_cl(6)
Public SA(6)          ' Surface areas for 6 body segments [m^2]
Public SA_total       ' Total surface area (sum of SA(1) to SA(6))

' Body node temperatures: Nodes 1-24 represent individual segments (4 nodes per segment),
' and node 25 is the central blood pool.
Public T(25) As Double
Public T_set(25) As Double     ' Set-point temperatures for nodes (in Kelvin)
Public T_sk(6) As Double       ' Skin temperatures for segments (node 4,8,...,24)

' Environmental conversion variables:
Public T_air, MRTK    ' T_air and MRT in Kelvin

' Wind & Posture Inputs:
Public v_air          ' Air speed [m/s]
Public posture        ' "sitting", "supine", or "standing"

' Heat Transfer Coefficients (for each of 6 segments)
Public hc_a(6), hc_b(6)
Public h_rad(6), h_conv(6)
Public f_cl(6)
Public h_total(6)
Public T_o(6)     ' Operative temperature [°C] computed from convection and radiation

'------ Control System Variables ------
Public ERR(25), WRM(25), CLD(25)
Public WRM_skin(6), CLD_skin(6)
Public VD, VC
Public BF_skin(6)
Public Q_shiv(6)
Public DF_TR(6), DF_VD(6), DF_VC(6), DF_SH(6), DF_SW(6), DF_work(6)

'------ Sweating & Evaporative Cooling Variables ------
Public Psat_sk(6), h_evap(6), Q_sweat_max(6), Q_sweat(6)
Public Skin_wettedness(6)

'------ Heat Generation & Blood Flow Variables ------
Public Q_total, Q_work
Public BMR_total         ' Total basal metabolic heat = sum(Q_bm) [W]
Public Q_work_seg(6)
Public Q_bm(25), BFB(25)   ' Basal metabolic heat generation and blood flow per node
Public TC(25)            ' Thermal conductance between nodes
Public Q(25), BF(25)
Public Q_TC(25), Q_bf(25)

'------ Post-Processing & Output Variables ------
Public T_new(25) As Double       ' Updated node temperatures [K]
Public T_ms(6) As Double         ' Mean skin temperature for each segment [K]
Public T_ms_total As Double      ' Aggregated mean skin temperature (weighted) [K]
Public w_sk_total, w_sk(6)       ' Aggregated mean skin wettedness
Public SHL_sk(6), LHL_sk(6), THL_sk(6)
Public res_sh, res_lh, RES
Public Q_conv(6), Q_rad_net(6), Qsw(6)
Public m_sweat(6)
Public Q_conv_ms, Q_rad_net_ms, Qsw_ms, Q_rad_out_ms, Q_rad_in_ms
Public CO                ' Cardiac output [l/hr]
Public Q_storage         ' Heat storage [W]
Public Core_Temp
Public Mean_Skin_T

Public L_v, HeatGenerated
Public dTime             ' Time step (sec)

'------ Aliases for Sensor Data ------
Alias SN500Data1(1) = SWin
Alias SN500Data1(2) = SWout
Alias SN500Data1(3) = LWin
Alias SN500Data1(4) = LWout
Alias SN500Data2(1) = SWnet
Alias SN500Data2(2) = LWnet
Alias SN500Data1_2(1) = SWin_2
Alias SN500Data1_2(2) = SWout_2
Alias SN500Data1_2(3) = LWin_2
Alias SN500Data1_2(4) = LWout_2
Alias SN500Data2_2(1) = SWnet_2
Alias SN500Data2_2(2) = LWnet_2
Alias SN500Data1_3(1) = SWin_3
Alias SN500Data1_3(2) = SWout_3
Alias SN500Data1_3(3) = LWin_3
Alias SN500Data1_3(4) = LWout_3
Alias SN500Data2_3(1) = SWnet_3
Alias SN500Data2_3(2) = LWnet_3
Alias N(1)=SmplsF
Alias N(2)=Diag1F
Alias N(3)=Diag2F
Alias N(4)=Diag4F
Alias N(5)=Diag8F
Alias N(6)=Diag9F
Alias N(7)=Diag10F
Alias N(8)=NNDF
Alias N(9)=CSEF
Alias GPSData(1) = Latitude_A
Alias GPSData(2) = Latitude_B
Alias GPSData(3) = Longitude_A
Alias GPSData(4) = Longitude_B
Alias GPSData(5) = Speed
Alias GPSData(6) = Course
Alias GPSData(7) = MagVar
Alias GPSData(8) = FixQual
Alias GPSData(9) = NumSats
Alias GPSData(10)= Altitude
Alias GPSData(11)= PPS
Alias GPSData(12)= SecSinceGPRMC
Alias GPSData(13)= GPSReady
Alias GPSData(14)= MaxClockChange
Alias GPSData(15)= NumClockChange

'------ Units ------
Units BattV=Volts
Units PTemp_C=Deg C
Units SWalbedo=W/m^2
Units NR=W/m^2
Units SWalbedo_2=W/m^2
Units NR_2=W/m^2
Units SWalbedo_3=W/m^2
Units NR_3=W/m^2
Units WindDir=degrees
Units WS_ms=meters/second
Units WSDiag=unitless
Units MRT=Deg C
Units AirTC=Deg C
Units RH=%
Units SWin=W/m^2
Units SWout=W/m^2
Units LWin=W/m^2
Units LWout=W/m^2
Units SWnet=W/m^2
Units LWnet=W/m^2
Units SWin_2=W/m^2
Units SWout_2=W/m^2
Units LWin_2=W/m^2
Units LWout_2=W/m^2
Units SWnet_2=W/m^2
Units LWnet_2=W/m^2
Units SWin_3=W/m^2
Units SWout_3=W/m^2
Units LWin_3=W/m^2
Units LWout_3=W/m^2
Units SWnet_3=W/m^2
Units LWnet_3=W/m^2
Units Latitude_A=degrees
Units Latitude_B=minutes
Units Longitude_A=degrees
Units Longitude_B=minutes
Units Speed=knots
Units Course=degrees
Units MagVar=degrees
Units FixQual=code
Units NumSats=count
Units Altitude=meters
Units PPS=microseconds
Units SecSinceGPRMC=seconds
Units GPSReady=count
Units MaxClockChange=milliseconds
Units NumClockChange=count

'==================================================
' Data Table Definitions
'==================================================

DataTable(Table1, True, -1)
  DataInterval(0,20,Sec,10)
  TableFile("CRD:OtherData", 64, -1, 0, 24, Hr, 0, 0)
 
  '--- Thermoregulation Model Outputs ---
  Sample(1, Core_Temp, FP2)
  Sample(1, w_sk_total, FP2)
  Sample(1, Mean_Skin_T, FP2)
  Sample(1, CO, FP2)
 
  '--- Heat Exchange Outputs ---
  Sample(1, Qsk_latent_total, FP2)
  Sample(1, Qsk_sensible_total, FP2)
  Sample(1, RES, FP2)
 
  '--- Environmental Sensor Measurements ---
  Sample(1, AirTC, FP2)
  Sample(1, RH, FP2)
  Sample(1, MRT, FP2, False)
  Sample(1,WS_ms,FP2)
 
  Sample(1, SWin, FP2)
  Sample(1, SWout, FP2)
  Sample(1, LWin, FP2)
  Sample(1, LWout, FP2)
  Sample(1, SWnet, FP2)
  Sample(1, LWnet, FP2)
  Sample(1, SWalbedo, FP2)
  Sample(1, NR, FP2)
  Sample(1, SWin_2, FP2)
  Sample(1, SWout_2, FP2)
  Sample(1, LWin_2, FP2)
  Sample(1, LWout_2, FP2)
  Sample(1, SWnet_2, FP2)
  Sample(1, LWnet_2, FP2)
  Sample(1, SWalbedo_2, FP2)
  Sample(1, NR_2, FP2)
  Sample(1, SWin_3, FP2)
  Sample(1, SWout_3, FP2)
  Sample(1, LWin_3, FP2)
  Sample(1, LWout_3, FP2)
  Sample(1, SWnet_3, FP2)
  Sample(1, LWnet_3, FP2)
  'Sample(1, NMEASent(1), String)
  'Sample(1, NMEASent(2), String)
  Sample(1, Latitude_A, FP2)
  Sample(1, Latitude_B, FP2)
  Sample(1, Longitude_A, FP2)
  Sample(1, Longitude_B, FP2)
  Sample(1, Speed, FP2)
  Sample(1, Course, FP2)
  Sample(1, MagVar, FP2)
  Sample(1, FixQual, FP2)
  Sample(1, NumSats, FP2)
  Sample(1, Altitude, FP2)
  Sample(1, PPS, FP2)
  Sample(1, SecSinceGPRMC, FP2)

EndTable

'==================================================
' Main Program
'==================================================

BeginProg

  '--- Initialization: Set initial body node temperatures and setpoints ---
  '---------- Body Node Temperatures & Setpoints ----------
  T_set(1) = 310.61: T_set(2) = 308.69: T_set(3) = 308.58: T_set(4) = 308.35: T_set(5) = 310.18
  T_set(6) = 309.57: T_set(7) = 308.87: T_set(8) = 307.93: T_set(9) = 309.29: T_set(10) = 307.86
  T_set(11) = 307.69: T_set(12) = 307.34: T_set(13) = 308.20: T_set(14) = 308.17: T_set(15) = 307.67
  T_set(16) = 307.59: T_set(17) = 309.81: T_set(18) = 309.29: T_set(19) = 308.46: T_set(20) = 307.25
  T_set(21) = 307.89: T_set(22) = 307.78: T_set(23) = 307.46: T_set(24) = 307.39: T_set(25) = 310.49

  ' Initialize actual node temperatures using the setpoints
  For j = 1 To 25
     T(j) = T_set(j)
  Next j

  '--- Measurements & Calculations every 20 sec ---
    PortPairConfig(C1, 2)
    SerialOpen(ComC5,9600,3,0,1945) 'Wind Sensor 2D
    Scan(20, Sec, 1, 0)
     
      '---------- Standard Sensor Measurements ----------
      Battery(BattV)
      PanelTemp(PTemp_C, 60)
      SDI12Recorder(SN500Data1(), C3, "U", "M!", 1, 0, -1)
      SDI12Recorder(SN500Data2(), C3, "U", "M1!", 1, 0, -1)
      SDI12Recorder(SWalbedo, C3, "U", "M4!", 1, 0)
      NR = SWnet + LWnet
      SDI12Recorder(SN500Data1_2(), C3, "L", "M!", 1, 0, -1)
      SDI12Recorder(SN500Data2_2(), C3, "L", "M1!", 1, 0, -1)
      SDI12Recorder(SWalbedo_2, C3, "L", "M4!", 1, 0)
      NR_2 = SWnet_2 + LWnet_2
      SDI12Recorder(SN500Data1_3(), C3, "B", "M!", 1, 0, -1)
      SDI12Recorder(SN500Data2_3(), C3, "B", "M1!", 1, 0, -1)
      SDI12Recorder(SWalbedo_3, C3, "B", "M4!", 1, 0)
      NR_3 = SWnet_3 + LWnet_3
     
     'WindSonic1 (RS-232 9.6K baud) Two Dimensional Ultrasonic Wind Sensor measurements 'WindDir', 'WS_ms', and 'WSDiag'
'Get data from WindSonic1 (RS-232 9.6K baud) Two Dimensional Ultrasonic Wind Sensor
SerialInRecord(ComC5,WSStr,&h02,0,&h0D0A,ByteRet,01)
SplitStr(WSData(),WSStr,",",4,4)
WindDir=WSData(1)
WS_ms=WSData(2)
WSDiag=WSData(4)
ChkSumF=HextoDec(Right(WSStr,2)) Eqv CheckSum(WSStr,9,Len(WSStr)-3)
'Set diagnostic variables as needed
If ByteRet=0 Then WSDiag=NAN
Move(SmplsF,9,0,1)
Select Case WSDiag
Case=0
SmplsF=1
Case=1
Diag1F=1
Case=2
Diag2F=1
Case=4
Diag4F=1
Case=8
Diag8F=1
Case=9
Diag9F=1
Case=10
Diag10F=1
Else
NNDF=1
EndSelect
If NOT (ByteRet<>0 IMP ChkSumF) Then CSEF=1
'GPS16X-HVS GPS Receiver measurements 'Latitude_A', 'Latitude_B', 'Longitude_A', 'Longitude_B', 'Speed', 'Course',
'MagVar', 'FixQual', 'NumSats', 'Altitude', 'PPS', 'SecSinceGPRMC', 'GPSReady', 'MaxClockChange', and 'NumClockChange'
'The datalogger clock will be synchronized to GPS time.


      GPS(GPSData(), ComC1, 0*3600, 500, NMEASent())
      SW12(SW12_1, 1, 0)
      Delay(0,2,Sec)
      VoltSe(AirTC, 1, mV1000, 1, False, 0, 60, 0.1, -40)
      VoltSe(RH, 1, mV1000, 2, False, 0, 60, 0.1, 0)
      SW12(SW12_1, 0, 0)
      If RH > 100 And RH < 103 Then RH = 100


      '---------- Define Subject & Clothing Parameters ----------
      weight = 74.43
      height = 1.81
      age = 30
      met = 1.3     ' Set metabolic rate as appropriate / desired
     
      SA(1) = 0.133: SA(2) = 0.680: SA(3) = 0.254: SA(4) = 0.095: SA(5) = 0.597: SA(6) = 0.130
      SA_total = SA(1)+SA(2)+SA(3)+SA(4)+SA(5)+SA(6)
     
      DF_work(1) = 0.000: DF_work(2) = 0.300: DF_work(3) = 0.080: DF_work(4) = 0.010: DF_work(5) = 0.600: DF_work(6) = 0.010
     
      DF_TR(1) = 0.0695: DF_TR(2) = 0.4935: DF_TR(3) = 0.0686: DF_TR(4) = 0.1845: DF_TR(5) = 0.1505: DF_TR(6) = 0.0334
     
      DF_VD(1) = 0.1320: DF_VD(2) = 0.3220: DF_VD(3) = 0.0950: DF_VD(4) = 0.1210: DF_VD(5) = 0.2300: DF_VD(6) = 0.1000
     
      DF_VC(1) = 0.0500: DF_VC(2) = 0.1500: DF_VC(3) = 0.0500: DF_VC(4) = 0.3500: DF_VC(5) = 0.0500: DF_VC(6) = 0.3500
     
      DF_SW(1) = 0.0810: DF_SW(2) = 0.4810: DF_SW(3) = 0.1540: DF_SW(4) = 0.0310: DF_SW(5) = 0.2180: DF_SW(6) = 0.0350
     
      DF_SH(1) = 0.0200: DF_SH(2) = 0.8500: DF_SH(3) = 0.0500: DF_SH(4) = 0.0000: DF_SH(5) = 0.0700: DF_SH(6) = 0.0000

      Rc_cl(1) = 0.0775: Rc_cl(2) = 0.0775: Rc_cl(3) = 0.0775 'Set clothing as appropriate / desired
      Rc_cl(4) = 0.0775: Rc_cl(5) = 0.0775: Rc_cl(6) = 0.0775 'Set clothing as appropriate / desired
      Re_cl(1) = 12.3: Re_cl(2) = 12.3: Re_cl(3) = 12.3 'Set clothing as appropriate / desired
      Re_cl(4) = 12.3: Re_cl(5) = 12.3: Re_cl(6) = 12.3 'Set clothing as appropriate / desired
     
      C(1) = 9288.48: C(2) = 1380.72: C(3) = 920.48: C(4) = 1004.16: C(5) = 41086.88
      C(6) = 67571.6: C(7) = 17782: C(8) = 5062.64: C(9) = 5899.44: C(10) = 12719.36
      C(11) = 2426.72: C(12) = 1799.12: C(13) = 585.76: C(14) = 251.04: C(15) = 376.56
      C(16) = 711.28: C(17) = 17740.16: C(18) = 38367.28: C(19) = 5983.12: C(20) = 4518.72
      C(21) = 962.32: C(22) = 251.04: C(23) = 543.92: C(24) = 920.48: C(25) = 9414.00
     
      Q_bm(1) = 14.93: Q_bm(2) = 0.12: Q_bm(3) = 0.13: Q_bm(4) = 0.09: Q_bm(5) = 52.78
      Q_bm(6) = 5.82: Q_bm(7) = 2.48: Q_bm(8) = 0.47: Q_bm(9) = 0.81: Q_bm(10) = 1.10
      Q_bm(11) = 0.20: Q_bm(12) = 0.15: Q_bm(13) = 0.09: Q_bm(14) = 0.23: Q_bm(15) = 0.03
      Q_bm(16) = 0.06: Q_bm(17) = 2.59: Q_bm(18) = 3.33: Q_bm(19) = 0.50: Q_bm(20) = 0.37
      Q_bm(21) = 0.15: Q_bm(22) = 0.02: Q_bm(23) = 0.05: Q_bm(24) = 0.08: Q_bm(25) = 0.00
     
      BFB(1) = 45.00: BFB(2) = 0.12: BFB(3) = 0.13: BFB(4) = 1.44: BFB(5) = 210.00
      BFB(6) = 6.00: BFB(7) = 2.56: BFB(8) = 2.10: BFB(9) = 0.84: BFB(10) = 1.14
      BFB(11) = 0.20: BFB(12) = 0.50: BFB(13) = 0.10: BFB(14) = 0.24: BFB(15) = 0.04
      BFB(16) = 2.00: BFB(17) = 2.69: BFB(18) = 3.43: BFB(19) = 0.52: BFB(20) = 2.85
      BFB(21) = 0.16: BFB(22) = 0.02: BFB(23) = 0.05: BFB(24) = 3.00: BFB(25) = 0.00
     
      TC(1) = 1.605: TC(2) = 13.258: TC(3) = 16.049: TC(4) = 0.000: TC(5) = 1.593
      TC(6) = 5.524: TC(7) = 23.027: TC(8) = 0.000: TC(9) = 1.396: TC(10) = 10.351
      TC(11) = 30.471: TC(12) = 0.000: TC(13) = 6.397: TC(14) = 11.223: TC(15) = 11.514
      TC(16) = 0.000: TC(17) = 10.467: TC(18) = 14.421: TC(19) = 74.432: TC(20) = 0.000
      TC(21) = 16.282: TC(22) = 20.585: TC(23) = 16.398: TC(24) = 0.000: TC(25) = 0.000

      '---------- Total Basal Metabolic Heat ----------
      BMR_total = 0
      For j = 1 To 25
         BMR_total = BMR_total + Q_bm(j)
      Next j
     
      dTime = 1
      For time = 1 To 20

       '---------- Environmental Conversions ----------
      T_air = AirTC + 273.15
      MRT = -273.15 + ((0.22*(0.7*SWin_2 + 0.97*LWin_2) + 0.22*(0.7*SWout_2 + 0.97*LWout_2) + 0.22*(0.7*SWin_3 + 0.97*LWin_3) + 0.22*(0.7*SWout_3 + 0.97*LWout_3) + 0.06*(0.7*SWin + 0.97*LWin) + 0.06*(0.7*SWout + 0.97*LWout)) / (0.97*(5.67E-8)))^0.25
      MRTK = MRT + 273.15
      Psat_air = EXP(77.3450 + 0.0057*T_air - 7235/T_air) / (T_air)^8.2
      P_air = (RH/100)*Psat_air
      P_atm = 101325
      L_c = (16.5/(P_atm/101325))/1000
     
      '---------- Identify Skin Temperatures (nodes 4,8,...,24) ----------
      For i = 1 To 6
         T_sk(i) = T(4*i)
      Next i
     
      '---------- Sonic Sensor Reading & Wind Speed Calculation ----------
      v_air = WS_ms 'From 2D
     
      '---------- Assume Posture (if not measured, use dummy value) ----------
      posture = "standing"
     
      '---------- Calculate Heat Transfer Coefficients ----------
      If v_air >= 0.2 Then
         hc_a(1)=15: hc_a(2)=13.67: hc_a(3)=17: hc_a(4)=20: hc_a(5)=15.02: hc_a(6)=15.10
         hc_b(1)=0.62: hc_b(2)=0.57: hc_b(3)=0.60: hc_b(4)=0.60: hc_b(5)=0.68: hc_b(6)=0.62
         h_rad(1)=4.89: h_rad(2)=4.26: h_rad(3)=4.49: h_rad(4)=4.21: h_rad(5)=5.08: h_rad(6)=6.14
         For i = 1 To 6
            h_conv(i) = hc_a(i) * (v_air ^ hc_b(i))
         Next i
      ElseIf posture = "sitting" And v_air < 0.2 Then
         h_conv(1)=4.75: h_conv(2)=2.49: h_conv(3)=3.69
         h_conv(4)=2.06: h_conv(5)=2.98: h_conv(6)=2.62
         h_rad(1)=4.96: h_rad(2)=4.27: h_rad(3)=4.59
         h_rad(4)=4.74: h_rad(5)=4.44: h_rad(6)=6.36
      ElseIf posture = "supine" And v_air < 0.2 Then
         hc_a(1)=1.11: hc_a(2)=1.21: hc_a(3)=1.49: hc_a(4)=2.18: hc_a(5)=0.67: hc_a(6)=0.20
         hc_b(1)=0.35: hc_b(2)=0.05: hc_b(3)=0.70: hc_b(4)=0.30: hc_b(5)=0.49: hc_b(6)=0.62
         For i = 1 To 6
            h_conv(i)= hc_a(i) * (ABS(T(4*i)-T_air) ^ hc_b(i))
         Next i
         h_rad(1)=5.48: h_rad(2)=3.46: h_rad(3)=4.52
         h_rad(4)=4.12: h_rad(5)=5.03: h_rad(6)=6.09
      ElseIf posture = "standing" And v_air < 0.2 Then
         h_conv(1)=4.48: h_conv(2)=2.91: h_conv(3)=3.59
         h_conv(4)=3.67: h_conv(5)=2.53: h_conv(6)=2.04
         h_rad(1)=4.89: h_rad(2)=4.26: h_rad(3)=4.49
         h_rad(4)=4.21: h_rad(5)=5.08: h_rad(6)=6.14
      End If
     
      '---------- Calculate Clothing-Adjusted Heat Transfer & Operative Temperature ----------
      For i = 1 To 6
         f_cl(i) = 1 + (1.81 * Rc_cl(i))
         h_total(i) = 1 / (Rc_cl(i) + 1 / (f_cl(i) * (h_conv(i) + h_rad(i))))
         T_o(i) = (h_conv(i)*T_air + h_rad(i)*MRTK) / (h_conv(i) + h_rad(i))
      Next i
     
      '========== Control System Calculations ==========
      '----- ERR signals: Difference between measured & set temperatures ----------
      For j = 1 To 25
         ERR(j) = T(j) - T_set(j)
         If ERR(j) > 0 Then
            WRM(j) = ERR(j)
         Else
            WRM(j) = 0
         End If
         If ERR(j) < 0 Then
            CLD(j) = ABS(ERR(j))'-ERR(j)
         Else
            CLD(j) = 0
         End If
      Next j
     
      '----- Skin-Thermoreceptor Integration (for nodes 4,8,...,24) ----------
      For i = 1 To 6
         k = 4 * i
         WRM_skin(i) = WRM(k) * DF_TR(i)
         CLD_skin(i) = CLD(k) * DF_TR(i)
      Next i
      WRMS = WRM_skin(1)+WRM_skin(2)+WRM_skin(3)+WRM_skin(4)+WRM_skin(5)+WRM_skin(6)
      CLDS = CLD_skin(1)+CLD_skin(2)+CLD_skin(3)+CLD_skin(4)+CLD_skin(5)+CLD_skin(6)
     
      '----- Skin Blood Flow ----------
      VD = (100.5 * ERR(1)) + (6.4 * (WRMS - CLDS))
      If VD < 0 Then VD = 0
      VC = (-10.8 * ERR(1)) + (-10.8 * (WRMS - CLDS))
      If VC < 0 Then VC = 0
      For i = 1 To 6
         k = 4 * i
         BF_skin(i) = ((1 + DF_VD(i) * VD) / (1 + DF_VC(i) * VC)) * BFB(k)
         BF_skin(i) = BF_skin(i) * (2^(ERR(k)/6))
         If BF_skin(i) > 90 Then BF_skin(i) = 90
      Next i
     
      '----- Shivering Heat Generation ----------
      Shivering = 24.36 * (-ERR(1)) * CLDS
      For i = 1 To 6
         Q_shiv(i) = DF_SH(i) * Shivering
      Next i
     
      '----- Sweating & Evaporative Cooling ----------
      For i = 1 To 6
         k = 4 * i
         Psat_sk(i) = EXP(77.3450 + 0.0057*T(k) - 7235/T(k)) / (T(k))^8.2
      Next i
      For i = 1 To 6
         h_evap(i) = 1 / (Re_cl(i) + (1 / (f_cl(i) * h_conv(i) * L_c)))
         Q_sweat_max(i) = h_evap(i) * (Psat_sk(i) - P_air) * SA(i)
      Next i
      SW = (371.2 * ERR(1)) + (33.64 * (WRMS - CLDS))
      If SW < 0 Then SW = 0
      For i = 1 To 6
         k = 4 * i
         Q_sweat(i) = DF_SW(i) * SW * (2^(ERR(k)/10))
         If Q_sweat(i) > Q_sweat_max(i) Then Q_sweat(i) = Q_sweat_max(i)
         Skin_wettedness(i) = 0.06 + 0.94 * (Q_sweat(i)/Q_sweat_max(i))
      Next i
      For i = 1 To 6
         Q_sweat(i) = Skin_wettedness(i) * h_evap(i) * (Psat_sk(i)-P_air) * SA(i)
      Next i
     
      '----- Heat Generation & Work ----------
      Q_total = met * 58.15 * SA_total
      If Q_total - BMR_total > 0 Then
         Q_work = (Q_total - BMR_total) * 0.78
      Else
         Q_work = 0
      End If
      For i = 1 To 6
         Q_work_seg(i) = Q_work * DF_work(i)
      Next i
     
      '----- Effective Heat Generation & Blood Flow per Segment ----------
      For i = 1 To 6
         k = (4 * i) - 3
         Q(k) = Q_bm(k)
         BF(k) = BFB(k)
         Q(k+1) = Q_bm(k+1) + Q_shiv(i) + Q_work_seg(i)
         BF(k+1) = BFB(k+1) + ((Q(k+1) - Q_bm(k+1))/1.163)
         Q(k+2) = Q_bm(k+2)
         BF(k+2) = BFB(k+2)
         Q(k+3) = Q_bm(k+3)
         BF(k+3) = BF_skin(i)
         Q_TC(k)   = TC(k)   * (T(k) - T(k+1))
         Q_TC(k+1) = TC(k+1) * (T(k+1) - T(k+2))
         Q_TC(k+2) = TC(k+2) * (T(k+2) - T(k+3))
         Q_TC(k+3) = 0
      Next i
     
      '----- Heat Transfer via Blood Flow ----------
      For j = 1 To 24
         Q_bf(j) = 1.163 * BF(j) * (T(j) - T(25))
      Next j
     
      '----- Net Heat Balance at Each Node ----------
      For i = 1 To 6
         k = (4 * i) - 3
         Q(k)   = Q(k)   - Q_bf(k)   - Q_TC(k)
         Q(k+1) = Q(k+1) - Q_bf(k+1) + Q_TC(k)   - Q_TC(k+1)
         Q(k+2) = Q(k+2) - Q_bf(k+2) + Q_TC(k+1) - Q_TC(k+2)
         Q(k+3) = Q(k+3) - Q_bf(k+3) + Q_TC(k+2) - Q_sweat(i) - ((h_total(i)*(T(k+3)-T_o(i)))*SA(i))
      Next i
     
      '----- Skin Heat Losses ----------
      For i = 1 To 6
         k = 4 * i
         SHL_sk(i) = (h_total(i) * (T(k) - T_o(i))) * SA(i)
         LHL_sk(i) = Q_sweat(i)
         THL_sk(i) = SHL_sk(i) + LHL_sk(i)
      Next i
     
      '----- Respiratory Heat Loss ----------
      res_sh = 0.0014 * ((34+273.15) - T_air)
      res_lh = 0.0173 * (5.87 - (P_air/1000))
      RES = (res_sh + res_lh) * Q_total
      Q(5) = Q(5) - RES
      Q(25) = 0
      For j = 1 To 24
         Q(25) = Q(25) + Q_bf(j)
      Next j
     
      '----- Update Node Temperatures (using time step dTime) ----------
      'dTime = 20   ' 20-second time step (matches the scan interval)
      For j = 1 To 25
         T_new(j) = T(j) + ((Q(j) / C(j)) * dTime)
      Next j
     
     
      '----- Post-Processing: Compute Aggregated Outputs ----------
      For i = 1 To 6
         k = 4 * i
         T_ms(i) = T_new(k) * (SA(i)/SA_total)
         w_sk(i) = (Skin_wettedness(i)*(SA(i)/SA_total))      
      Next i
     
      T_ms_total = T_ms(1)+T_ms(2)+T_ms(3)+T_ms(4)+T_ms(5)+T_ms(6)
      Mean_Skin_T = T_ms_total - 273.15
      Core_Temp = T(5) - 273.15
      w_sk_total = w_sk(1) + w_sk(2)+ w_sk(3) + w_sk(4) + w_sk(5) + w_sk(6)
     
      Qsk_latent_total = LHL_sk(1)+LHL_sk(2)+LHL_sk(3)+LHL_sk(4)+LHL_sk(5)+LHL_sk(6)
      Qsk_sensible_total = SHL_sk(1)+SHL_sk(2)+SHL_sk(3)+SHL_sk(4)+SHL_sk(5)+SHL_sk(6)
     
      CO = 0
      For j = 1 To 25
         CO = CO + BF(j)
      Next j
     
      Q_storage = BMR_total + Q_work + (Q_shiv(1)+Q_shiv(2)+Q_shiv(3)+Q_shiv(4)+Q_shiv(5)+Q_shiv(6)) - Qsk_latent_total - Qsk_sensible_total - RES
     
      L_v = 2.43E6
      HeatGenerated = Q_total
      For i = 1 To 6
         k = 4 * i
         Q_conv(i) = (h_conv(i) * (T(k) - T_air)) * (SA(i)/SA_total)
         Q_rad_net(i) = (h_rad(i) * (T(k) - MRTK)) * (SA(i)/SA_total)
         Qsw(i) = Q_sweat(i) * (SA(i)/SA_total)
         m_sweat(i) = (Q_sweat(i) / L_v) * 3600 'convert from kg/sec to L/hr
      Next i
     
      m_sweat_total = m_sweat(1) + m_sweat(2) + m_sweat(3) + m_sweat(4) + m_sweat(5) + m_sweat(6)

      Q_conv_ms = Q_conv(1)+Q_conv(2)+Q_conv(3)+Q_conv(4)+Q_conv(5)+Q_conv(6)
      Q_rad_net_ms = Q_rad_net(1)+Q_rad_net(2)+Q_rad_net(3)+Q_rad_net(4)+Q_rad_net(5)+Q_rad_net(6)
      Qsw_ms = Qsw(1)+Qsw(2)+Qsw(3)+Qsw(4)+Qsw(5)+Qsw(6)
      Q_rad_out_ms = 5.67E-8 * 0.95 * 0.88 * (T_ms_total^4)
      Q_rad_in_ms  = 5.67E-8 * 0.95 * 0.88 * (MRTK^4)
     
      '---------- End of Calculations ----------
     
      '----- Carry over the updated temperatures for the next scan -----
      For j = 1 To 25
         T(j) = T_new(j)
      Next j
     

      Next time
      '--- Call Table1 to log all environmental & computed outputs ---
      CallTable Table1
     
    NextScan
  EndProg